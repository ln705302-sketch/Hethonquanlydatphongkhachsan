{
  "name": "sunrise-hotel-server",
  "version": "1.0.0",
  "private": true,
  "description": "REST API cho website Sunrise Hotel (Node.js + Express + Oracle 23ai)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:setup": "node src/migrate.js",
    "db:reset": "node src/migrate.js --reset",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "oracledb": "^6.7.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
